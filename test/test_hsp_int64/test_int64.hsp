#runtime "hsp3cl"

a = int64("858993459200")
mes "a => " + a

a+
mes "a+ => " + a

a += 10
mes "a += 10 => " + a

a += 10.1
mes "a += 10.1 => " + a

a -= 20
mes "a -= 20 = >" + a

a *= 30
mes "a *= 30 => " + a

a /= 3
mes "a /= 3 => " + a

a \= int64("800000000000")
mes "a \\= 800000000000 => " + a

a \= 111.0
mes "a \\= 11.0 => " + a

a \= 11
mes "a \\= 11 => " + a
