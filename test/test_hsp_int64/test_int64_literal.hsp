#runtime "hsp3cl"

; int64リテラル (Lサフィックス) のテスト

; 10進数リテラル
a = 1L
mes a

; 32bitを超える値
b = 9999999999L
mes b

; 負数
c = -1L
mes c

; 16進数リテラル (32bit範囲内)
d = $FFFFFFFFL
mes d

; 16進数リテラル (32bitを超える値)
e = $100000000L
mes e

; 負の16進数リテラル
j = $FFFFFFFFFFFFFFFFL
mes j

; 負の16進数リテラル (32bitを超える値)
k = $FFFFFFFF00000000L
mes k

; 2進数リテラル (32bitを超える値)
f = %100000000000000000000000000000000L
mes f

; 式中での演算
g = 1000000000L + 2000000000L
mes g

; 変数同士の演算
h = 3000000000L
i = h * 2L
mes i
