; test_dll_int64.hsp
; DLL呼び出しでのint64返り値・引数テスト
; 返り値はstat64で確認（#cfuncは返り値型指定なし）
#runtime "hsp3cl"

#uselib "libc.so.6"
#cfunc c_atoll   "atoll"   str         ; str → long long (int64)
#cfunc c_strlen  "strlen"  sptr        ; sptr → size_t (64bit)
#func  c_tmpfile "tmpfile"             ; void → FILE*
#func  c_fclose  "fclose"  int64       ; FILE* → int
#func  c_fseeko  "fseeko"  int64, int64, int  ; FILE*, off_t, whence → int
#cfunc c_ftello  "ftello"  int64       ; FILE* → off_t (int64)

#uselib "libm.so.6"
#cfunc c_llround "llround" double      ; double → long long (int64)

dimtype ret, vartype("int64"), 1
dimtype fp, vartype("int64"), 1
dimtype offset, vartype("int64"), 1

; === int64 返り値テスト ===
mes "=== int64 return value ==="

; 32bitに収まる値: statとstat64は一致
ret = c_atoll("12345")
mes "atoll(12345) stat=" + stat + " stat64=" + stat64

; 2^33: statは0(下位32bit)、stat64に正確な値
ret = c_atoll("8589934592")       ; 引数はstr(文字列)なのでリテラル変換不要
mes "atoll(2^33) stat=" + stat + " stat64=" + stat64

; INT64_MAX
ret = c_atoll("9223372036854775807")
mes "atoll(INT64_MAX) stat64=" + stat64

; 負の値
ret = c_atoll("-1")
mes "atoll(-1) stat=" + stat + " stat64=" + stat64

; strlen: size_t (64bit) 返り値
ret = c_strlen("Hello, World!")
mes "strlen(Hello, World!) stat64=" + stat64

; llround: double → long long
ret = c_llround(3.7)
mes "llround(3.7) stat64=" + stat64

ret = c_llround(8589934592.0)     ; doubleリテラルは32bit超えも問題なし
mes "llround(2^33) stat64=" + stat64

; === int64 引数テスト ===
mes "=== int64 argument ==="

; tmpfile() でFILE*を取得し、fseeko(int64 offset)でシーク後ftelloで確認
c_tmpfile
fp = stat64
if fp != 0 : mes "tmpfile: ok" : else : mes "tmpfile: failed"

; 2^33 = 8589934592 オフセット: int (32bit) では表現不可
offset = int64("8589934592")
c_fseeko fp, offset, 0
ret = c_ftello(fp)
mes "fseeko/ftello(2^33) stat64=" + stat64

; 2^40 = 1099511627776 オフセット (1TB, 32bitでは表現不可)
offset = int64("1099511627776")
c_fseeko fp, offset, 0
ret = c_ftello(fp)
mes "fseeko/ftello(2^40) stat64=" + stat64

c_fclose fp
