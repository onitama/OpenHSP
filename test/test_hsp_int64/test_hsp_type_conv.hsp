; Test for explicit numeric type conversions involving int64
#include "hsp3cl.as"

mes "=== type conversion ==="

; int -> int64
i = 42
i64 = int64(i)
mes "int->int64: " + str(i64) + " type " + vartype(i64)

; large int64 -> int (truncation to lower 32 bits)
i64 = 4294967297L
i32 = int(i64)
mes "int64->int: " + str(i32) + " type " + vartype(i32)

; double -> int64
d = 1.5e10
i64 = int64(d)
mes "double->int64: " + str(i64) + " type " + vartype(i64)

; int64 -> double
i64 = 9007199254740992L
d = double(i64)
mes "int64->double: " + strf("%.0f", d) + " type " + vartype(d)

; negative int64 -> int
i64 = -1L
i32neg = int(i64)
mes "neg int64->int: " + str(i32neg) + " type " + vartype(i32neg)

; int64 zero
i64 = 0L
mes "zero: " + str(i64) + " type " + vartype(i64)
